{:paths ["src"]
 ;; kotodama 言霊 — the generic functional-organism RUNTIME on the kotoba-clj stack.
 ;; Domain logic (capability / taxonomy / fleet) is INJECTED by the concrete actor
 ;; (e.g. etzhayyim/root 20-actors/unspsc); kotodama only provides the reusable
 ;; organism machinery: life (joucho/heartbeat/prior-consensus), the validate→reason→emit
 ;; graph, and the ReAct template — persisted as-of on the kotoba Datom log.
 ;;   langgraph — StateGraph + create-react-agent + datomic-checkpointer
 ;;   langchain — ChatModel (Murakumo via openai-model) + kotoba-db backend (transitive)
 :deps {io.github.kotoba-lang/langgraph
        {:git/tag "v0.2.1" :sha "eaab7d9bf4b66a76bf0927298b53232e4e6c6ed6"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; local workspace dev (siblings under orgs/kotoba-lang/)
  :dev {:override-deps {io.github.kotoba-lang/langgraph {:local/root "../langgraph"}
                        io.github.kotoba-lang/langchain {:local/root "../langchain"}}}}}
