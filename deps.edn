{:paths ["src"]
 ;; kotodama 言霊 — the generic functional-organism RUNTIME on the kotoba-clj stack.
 ;; Domain logic (capability / taxonomy / fleet) is INJECTED by the concrete actor
 ;; (e.g. etzhayyim/root 20-actors/unspsc); kotodama only provides the reusable
 ;; organism machinery: life (joucho/heartbeat/prior-consensus), the validate→reason→emit
 ;; graph, and the ReAct template — persisted as-of on the kotoba Datom log.
 ;;   langgraph-clj — StateGraph + create-react-agent + datomic-checkpointer
 ;;   langchain-clj — ChatModel (Murakumo via openai-model) + kotoba-db backend (transitive)
 :deps {io.github.com-junkawasaki/langgraph-clj
        {:git/tag "v0.2.1" :git/sha "eaab7d9"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; local workspace dev (siblings under orgs/com-junkawasaki/)
  :dev {:override-deps {io.github.com-junkawasaki/langgraph-clj {:local/root "../langgraph-clj"}
                        io.github.com-junkawasaki/langchain-clj {:local/root "../langchain-clj"}}}}}
